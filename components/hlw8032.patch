Local change to ESPHome 2026.11.1's stock hlw8032 component (esphome/components/hlw8032).
- Adds power_factor_tolerance (default 5%): a calculated power factor between 1 and 1 + tolerance is
  reported as 1, not discarded as impossible.
- Adds min_current (default 50 mA): current is only reported when power / voltage exceeds it, as the
  cse7766 component does, so the noise floor isn't published as a current with no load.
Apply with: git apply hlw8032.patch

diff --git a/esphome/components/hlw8032/hlw8032.cpp b/esphome/components/hlw8032/hlw8032.cpp
index eec9bc4..c5fd706 100644
--- a/esphome/components/hlw8032/hlw8032.cpp
+++ b/esphome/components/hlw8032/hlw8032.cpp
@@ -143,7 +143,7 @@ void HLW8032Component::parse_data_() {
   PUBLISH_STATE(this->power_sensor_, power);
 
   float current = 0.0f;
-  if (have_current && current_reg) {
+  if (have_current && current_reg && voltage > 1.0f && power / voltage > this->min_current_) {
     current = float(current_parameter) * current_multiplier / float(current_reg);
   }
   PUBLISH_STATE(this->current_sensor_, current);
@@ -154,6 +154,9 @@ void HLW8032Component::parse_data_() {
     if (have_power || power_cycle_exceeds_range) {
       if (apparent_power > 0) {
         pf = power / apparent_power;
+        if (pf > 1 && pf <= 1 + this->power_factor_tolerance_) {
+          pf = 1.0f;
+        }
         if (pf < 0 || pf > 1) {
           ESP_LOGD(TAG, "Impossible power factor: %.4f not in interval [0, 1]", pf);
           pf = NAN;
@@ -172,8 +175,11 @@ void HLW8032Component::dump_config() {
   ESP_LOGCONFIG(TAG,
                 "Configuration:\n"
                 "  Current resistor: %.1f mΩ\n"
-                "  Voltage Divider: %.3f",
-                this->current_resistor_ * 1000.0f, this->voltage_divider_);
+                "  Voltage Divider: %.3f\n"
+                "  Power Factor Tolerance: %.1f%%\n"
+                "  Min Current: %.3f A",
+                this->current_resistor_ * 1000.0f, this->voltage_divider_, this->power_factor_tolerance_ * 100.0f,
+                this->min_current_);
   LOG_SENSOR("  ", "Voltage", this->voltage_sensor_);
   LOG_SENSOR("  ", "Current", this->current_sensor_);
   LOG_SENSOR("  ", "Power", this->power_sensor_);
